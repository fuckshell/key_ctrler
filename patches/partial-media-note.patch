+"""Keep an explicitly partial media note; never certify it as exact OCR."""
+import hashlib
+import json
+import re
+from datetime import datetime, timezone
+from pathlib import Path
+
+UNCLEAR = re.compile(r'看不清|无法辨认|难以辨认|字迹不清|无法识别|[?？]{2,}|^\s*[?？]\s*$')
+
+
+def partial_note(receipt, sha):
+    if (receipt.get('source_sha256') != sha or receipt.get('validation') != 'rejected'
+            or receipt.get('validation_error') != 'table-row-mapping-incomplete'):
+        return None
+    from image_store import is_flash_record
+    if not is_flash_record(receipt):
+        return None
+    response = receipt.get('response')
+    blocks = response.get('blocks') if isinstance(response, dict) else None
+    if not isinstance(blocks, list):
+        return None
+    fields, uncertain, text = [], [], []
+    for block in blocks:
+        if not isinstance(block, dict):
+            return None
+        rows, prose = block.get('rows'), block.get('text')
+        if not isinstance(rows, list) or not isinstance(prose, str):
+            return None
+        if not rows:
+            if prose.strip():
+                text.append(prose.strip())
+            continue
+        if (prose.strip() or block.get('header_depth') != 1 or rows[0] != ['字段路径', '内容']
+                or len(rows) < 2):
+            return None
+        for row in rows[1:]:
+            if not isinstance(row, list) or len(row) != 2 or not all(isinstance(s, str) for s in row):
+                return None
+            label, value = (s.strip() for s in row)
+            if not label or UNCLEAR.search(label):
+                return None
+            ambiguous = bool(UNCLEAR.search(value))
+            if ambiguous:
+                uncertain.append(label)
+            fields.append({'field': label, 'read': value, 'uncertain': ambiguous})
+            # Keep partially readable strings verbatim; do not fill in an unknown name.
+            text.append(f'{label}：{value or "（原转写为空）"}')
+    if not uncertain or not any(f['read'] and not f['uncertain'] for f in fields):
+        return None
+    return {'summary': '图片转写（部分可辨，未经逐格复核）\n' + '\n'.join(text),
+            'partial_transcription': {'source_sha256': sha, 'fields': fields,
+                                      'uncertain_fields': uncertain, 'exact': False},
+            'summary_provider': receipt['provider'], 'summary_model': receipt['model']}
+
+
+def candidate(row):
+    sha = row.get('file_sha') or ''
+    return (row.get('kind') == 'image' and row.get('status') == 'pending'
+            and row.get('captured_tier') == 'middle' and row.get('middle_pending') is False
+            and re.fullmatch('[0-9a-f]{64}', sha) and row.get('middle_sha256') == sha
+            and not row.get('summary') and not row.get('backlog_api_job')
+            and not row.get('completion_validation_failure')
+            and 'table-row-mapping-incomplete' in str(row.get('vision_last_error') or ''))
+
+
+def irrelevant_job(job, row):
+    key, sha = row.get('message_key'), row.get('file_sha')
+    event = job.get('event') or {}
+    result = (((job.get('result') or {}).get('vision_calendar') or {}).get('result') or {})
+    triage = result.get('triage') or {}
+    return bool(key and key == event.get('media_message_key') == result.get('message_key')
+                and sha == event.get('media_file_sha256') and job.get('status') == 'succeeded'
+                and result.get('ok') is True and result.get('calendar') is False
+                and result.get('reason') == 'irrelevant-image' and triage.get('relevance') == 'irrelevant')
+
+
+def reconcile(rows, *, message_key='', file_sha=''):
+    from media_lib import WORKSPACE, load_manifest, append_manifest, rebuild_media_index
+    from distill_media import resolve_file
+    from image_retry import is_requested, read_demands
+    from media_item_lock import item_lock
+    if not rows:
+        return 0
+    targets = {r['id']: r for r in rows if r.get('id') and candidate(r)
+               and (not message_key or r.get('message_key') == message_key)
+               and (not file_sha or r.get('file_sha') == file_sha)}
+    if not targets:
+        return 0
+    try:
+        jobs = json.loads((WORKSPACE/'state/wechat-postprocess-jobs.json').read_text())['jobs']
+    except (OSError, ValueError, KeyError):
+        return 0
+    by_key = {j.get('event', {}).get('media_message_key'): j for j in jobs if j.get('event')}
+    count = 0
+    for ident, old in targets.items():
+        job = by_key.get(old.get('message_key'), {})
+        if not irrelevant_job(job, old):
+            continue
+        with item_lock(ident) as owned:
+            if not owned:
+                continue
+            row = next((r for r in load_manifest() if r.get('id') == ident), {})
+            if not candidate(row) or not irrelevant_job(job, row) or is_requested(row, demands=read_demands()):
+                continue
+            sha = row['file_sha']; src = resolve_file(row)
+            try:
+                if not src or hashlib.sha256(Path(src).read_bytes()).hexdigest() != sha:
+                    continue
+            except OSError:
+                continue
+            files = sorted((WORKSPACE/'state/table-read-evidence'/sha).glob('*.json'), reverse=True)
+            if not files:
+                continue
+            try:
+                note = partial_note(json.loads(files[0].read_text()), sha)
+            except (ValueError, OSError):
+                continue
+            if note:
+                note['partial_transcription']['receipt'] = files[0].name
+                append_manifest(dict(row, **{**note, 'status':'done', 'vision_state':'done',
+                    'screening_decision':'summary_partial', 'screening_relevance':'irrelevant',
+                    'summary_confidence':None, 'summary_model_confidence':None,
+                    'summary_confidence_source':'partial-single-read', 'summary_source_sha256':sha,
+                    'vision_last_error':None, 'summary_failure_detail':None, 'summary_failure_stage':None,
+                    'vision_next_retry_at':None, 'summarized_at':datetime.now(timezone.utc).isoformat()}))
+                count += 1
+    if count:
+        rebuild_media_index(load_manifest())
+    return count
